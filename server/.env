# Copy this file to .env and fill in your values
# cp .env.example .env

# ===== PDF Chat AI — Environment Variables =====

# App
APP_NAME=PDF Chat AI
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:2822004@localhost:5432/pdf_chat_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=dev-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PDF Upload
MAX_PDF_SIZE_MB=50
UPLOAD_DIR=uploads

# AI Model API Keys
OPENAI_API_KEY=
GOOGLE_API_KEY=AIzaSyAZGFapREtgctsqepiCxayVCIKsUdA-Lds
GROQ_API_KEY=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
ANTHROPIC_API_KEY=
