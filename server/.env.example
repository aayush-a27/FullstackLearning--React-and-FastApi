# ===== PDF Chat AI — Environment Variables =====

# App
APP_NAME=PDF Chat AI
APP_VERSION=1.0.0
DEBUG=True
API_V1_PREFIX=/api/v1

# CORS — comma-separated allowed origins
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pdf_chat_ai

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT — CHANGE THESE IN PRODUCTION!
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PDF Upload
MAX_PDF_SIZE_MB=50
UPLOAD_DIR=uploads

# AI Model API Keys (set the ones you want to use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
